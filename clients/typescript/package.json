{
  "name": "@strongbox/client",
  "version": "0.3.0",
  "description": "TypeScript client for the Strongbox API. Types are generated from internal/api/openapi.json.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "generate": "openapi-typescript ../../internal/api/openapi.json -o src/schema.d.ts",
    "check-generated": "openapi-typescript ../../internal/api/openapi.json -o /tmp/strongbox-schema.d.ts && diff -u src/schema.d.ts /tmp/strongbox-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "example": "node examples/demo.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@types/node": "22.18.0"
  }
}
