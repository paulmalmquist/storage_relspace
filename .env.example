# Local development. Copy to .env. Never use these settings for CUI.
STRONGBOX_ENV=dev
STRONGBOX_DATABASE_URL=sqlite:///./.strongbox/strongbox.db
STRONGBOX_DEV_JWT_SECRET=replace-with-at-least-32-random-characters
STRONGBOX_LOCAL_KEYRING_PATH=.strongbox/keyring.json
STRONGBOX_BLOB_LOCAL_PATH=.strongbox/blobs

# Postgres instead of SQLite (Cloud SQL, AlloyDB, or a self-hosted Supabase Postgres):
# STRONGBOX_DATABASE_URL=postgresql+psycopg://user@host:5432/strongbox

# S3-compatible object store (MinIO, self-hosted Supabase Storage at /storage/v1/s3):
# STRONGBOX_BLOB_BACKEND=s3
# STRONGBOX_S3_BUCKET=strongbox
# STRONGBOX_S3_ENDPOINT_URL=http://localhost:9000
# STRONGBOX_S3_REGION=us-east-1

# Production on GCP (see infra/terraform):
# STRONGBOX_ENV=production
# STRONGBOX_AUTH_MODE=oidc
# STRONGBOX_JWT_AUDIENCES=["strongbox-api"]
# STRONGBOX_KMS_BACKEND=gcp
# STRONGBOX_KMS_KEY_NAME=projects/P/locations/us-east4/keyRings/strongbox-keys/cryptoKeys/strongbox-data-kek
# STRONGBOX_BLOB_BACKEND=gcs
# STRONGBOX_GCS_BUCKET=my-org-strongbox-blobs
# STRONGBOX_REQUIRE_FIPS=true
# STRONGBOX_EXPOSE_DOCS=false

# MCP server (stdio)
# STRONGBOX_MCP_API_URL=http://127.0.0.1:8080
# STRONGBOX_MCP_TOKEN=<agent token from `strongbox token agent:claude`>
# STRONGBOX_MCP_ON_BEHALF_OF=<your token from `strongbox token you@example.com`>
